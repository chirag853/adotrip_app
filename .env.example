# Copy to .env and restart: npx expo start -c
# Direct API (broken cert chain — keep for reference):
# EXPO_PUBLIC_PACKAGES_API_URL=https://www.adotrip.com/api/v1/packages
#
# OPTION 1 — Local proxy (dev only, same Wi-Fi chahiye):
#   npm run proxy:restart   (purana atka proxy kill + fresh start)
#   npm run proxy:check     (proxy + upstream health, FAIL line = asli kaaran)
#   Phir phone browser me kholo: http://<PC-IP>:8787?ping=1  -> {"ok":true}
EXPO_PUBLIC_PACKAGES_PROXY_URL=
#
# OPTION 2 — Cloud proxy (permanent fix, Wi-Fi tension khatm):
#   Render: dashboard -> New -> Blueprint -> ye repo (render.yaml ready hai)
#   Cloudflare: Worker me proxy/packages-proxy.worker.js paste -> Deploy
#   Phir yahan cloud URL dalo:
# EXPO_PUBLIC_PACKAGES_PROXY_URL=https://<service>.onrender.com
# ya
# EXPO_PUBLIC_PACKAGES_PROXY_URL=https://<your-worker>.workers.dev
