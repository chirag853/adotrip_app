{
  "name": "adotrip_app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/set-proxy-ip.js && node scripts/ensure-proxy.js",
    "start": "expo start",
    "dev:phone": "node scripts/set-proxy-ip.js && node scripts/ensure-proxy.js && expo start -c",
    "proxy": "node proxy/render-proxy.js",
    "proxy:restart": "node scripts/restart-proxy.js",
    "proxy:check": "node scripts/check-proxy.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-preset-expo": "~57.0.13"
  },
  "private": true
}
